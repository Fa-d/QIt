[{"n":1,"g":6222,"ar":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","en":"Say, \"He is Allah, [who is] One,","bn":"বলুন, তিনি আল্লাহ, এক,"},{"n":2,"g":6223,"ar":"ٱللَّهُ ٱلصَّمَدُ","en":"Allah, the Eternal Refuge.","bn":"আল্লাহ অমুখাপেক্ষী,"},{"n":3,"g":6224,"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","en":"He neither begets nor is born,","bn":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি"},{"n":4,"g":6225,"ar":"وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ","en":"Nor is there to Him any equivalent.\"","bn":"এবং তার সমতুল্য কেউ নেই।"}]