# Copy to keystore.properties (gitignored) to sign release builds with the upload key.
# Without it, release builds come out unsigned. CI can set the QIT_UPLOAD_* environment
# variables instead: QIT_UPLOAD_STORE_FILE, QIT_UPLOAD_STORE_PASSWORD, QIT_UPLOAD_KEY_ALIAS,
# QIT_UPLOAD_KEY_PASSWORD.
storeFile=/absolute/path/to/qandeel-upload.jks
storePassword=
keyAlias=upload
keyPassword=
