<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup on Android 11 and below (data_extraction_rules.xml covers 12+). Settings (DataStore,
   under files/datastore) and listening progress (quran.db, with its write-ahead log) are backed
   up; the downloaded audio (files/quran_audio) and ExoPlayer's index of it (exoplayer_internal.db)
   are not: they can run past Auto Backup's 25 MB cap, which would drop the whole backup, and they
   download again.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <include domain="database" path="." />
    <exclude domain="database" path="exoplayer_internal.db" />
</full-backup-content>
