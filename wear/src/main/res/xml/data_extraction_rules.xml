<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device transfer on Android 12+: settings and listening progress only, as in
   backup_rules.xml. The downloaded audio stays behind on a cloud backup; a device-to-device
   transfer has no size cap, but ExoPlayer's download index must travel with the files, so both
   stay behind there too and surahs download again.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
        <exclude domain="database" path="exoplayer_internal.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="." />
        <exclude domain="database" path="exoplayer_internal.db" />
    </device-transfer>
</data-extraction-rules>
